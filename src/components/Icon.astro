---
// Inline SVG icon set — stroke based, inherits currentColor. No icon library, no emoji.
type IconName =
  | 'search'
  | 'heart'
  | 'user'
  | 'bag'
  | 'filter'
  | 'whatsapp'
  | 'phone'
  | 'mail'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'chevron-down'
  | 'close'
  | 'menu'
  | 'instagram'
  | 'youtube'
  | 'facebook'
  | 'star'
  | 'sun'
  | 'moon'
  | 'grid';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Decorative by default; pass a label to expose it to assistive tech. */
  label?: string;
}

const { name, size = 20, class: className, label } = Astro.props;
const a11y = label
  ? { role: 'img', 'aria-label': label }
  : { 'aria-hidden': 'true', focusable: 'false' };

const stroke = {
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.6,
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  {...a11y}
>
  {name === 'search' && (
    <g {...stroke}><circle cx="11" cy="11" r="6.5"></circle><path d="m20 20-3.7-3.7"></path></g>
  )}
  {name === 'heart' && (
    <path
      {...stroke}
      d="M12 20s-7-4.35-9.2-8.2C1.1 8.9 2.6 5.5 6 5.5c2 0 3.2 1.2 4 2.4.8-1.2 2-2.4 4-2.4 3.4 0 4.9 3.4 3.2 6.3C19 15.65 12 20 12 20Z"
    ></path>
  )}
  {name === 'user' && (
    <g {...stroke}><circle cx="12" cy="8" r="3.6"></circle><path d="M5 20c1.2-3.6 4-5.2 7-5.2s5.8 1.6 7 5.2"></path></g>
  )}
  {name === 'bag' && (
    <g {...stroke}>
      <path d="M6 8h12l1 12H5L6 8Z"></path>
      <path d="M9 8V6.5A3 3 0 0 1 15 6.5V8"></path>
    </g>
  )}
  {name === 'filter' && (
    <g {...stroke}><path d="M4 7h16"></path><path d="M7 12h10"></path><path d="M10 17h4"></path></g>
  )}
  {name === 'whatsapp' && (
    <g {...stroke}>
      <path d="M4 20l1.4-4.1A7.6 7.6 0 1 1 8.6 19L4 20Z"></path>
      <path d="M9.2 9c-.2 1.4.6 2.9 1.7 4 1.1 1.1 2.6 1.9 4 1.7.5-.1.9-.5 1.1-1 .1-.4 0-.7-.3-.9l-1.4-.8c-.3-.2-.6-.1-.8.1l-.5.5c-.8-.4-1.7-1.3-2.1-2.1l.5-.5c.2-.2.3-.5.1-.8l-.8-1.4c-.2-.3-.5-.4-.9-.3-.5.2-.9.6-1 1.1Z"></path>
    </g>
  )}
  {name === 'phone' && (
    <path
      {...stroke}
      d="M6 4h3l1.5 4-2 1.5a11 11 0 0 0 5 5L21 12.5 22 16v3a2 2 0 0 1-2.2 2A17 17 0 0 1 3 5.2 2 2 0 0 1 5 3"
    ></path>
  )}
  {name === 'mail' && (
    <g {...stroke}><rect x="3.5" y="5.5" width="17" height="13" rx="1.5"></rect><path d="m4 7 8 6 8-6"></path></g>
  )}
  {name === 'arrow-right' && <path {...stroke} d="M4 12h15m-6-6 6 6-6 6"></path>}
  {name === 'arrow-up-right' && <path {...stroke} d="M7 17 17 7m-8 0h8v8"></path>}
  {name === 'chevron-down' && <path {...stroke} d="m6 9 6 6 6-6"></path>}
  {name === 'close' && <path {...stroke} d="M6 6l12 12M18 6 6 18"></path>}
  {name === 'menu' && <g {...stroke}><path d="M4 8h16"></path><path d="M4 16h16"></path></g>}
  {name === 'instagram' && (
    <g {...stroke}>
      <rect x="4" y="4" width="16" height="16" rx="4.5"></rect>
      <circle cx="12" cy="12" r="3.6"></circle>
      <circle cx="16.5" cy="7.5" r="0.6" fill="currentColor"></circle>
    </g>
  )}
  {name === 'youtube' && (
    <g {...stroke}>
      <rect x="3" y="6" width="18" height="12" rx="3.5"></rect>
      <path d="m10.5 9.5 4.5 2.5-4.5 2.5Z" fill="currentColor"></path>
    </g>
  )}
  {name === 'facebook' && (
    <path {...stroke} d="M14.5 8.5H13c-1 0-1.5.5-1.5 1.5v2H14l-.5 2.5h-2V21M12 3a9 9 0 1 0 0 18"></path>
  )}
  {name === 'star' && (
    <path
      d="M12 3.3 14.6 9l6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1L9.4 9 12 3.3Z"
      fill="currentColor"
      stroke="currentColor"
      stroke-width="1"
      stroke-linejoin="round"
    ></path>
  )}
  {name === 'sun' && (
    <g {...stroke}>
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 3v2.2M12 18.8V21M4.2 12H2M22 12h-2.2M5.8 5.8l1.5 1.5M16.7 16.7l1.5 1.5M18.2 5.8l-1.5 1.5M7.3 16.7l-1.5 1.5"></path>
    </g>
  )}
  {name === 'moon' && (
    <path {...stroke} d="M20 14.3A8.4 8.4 0 1 1 9.7 4a6.7 6.7 0 0 0 10.3 10.3Z"></path>
  )}
  {name === 'grid' && (
    <g {...stroke}>
      <rect x="3.5" y="3.5" width="7" height="7" rx="1"></rect>
      <rect x="13.5" y="3.5" width="7" height="7" rx="1"></rect>
      <rect x="3.5" y="13.5" width="7" height="7" rx="1"></rect>
      <rect x="13.5" y="13.5" width="7" height="7" rx="1"></rect>
    </g>
  )}
</svg>
