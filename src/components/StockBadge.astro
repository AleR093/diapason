---
import type { StockState } from '@/lib/types';

interface Props {
  state: StockState;
}
const { state } = Astro.props;
const label = state === 'disponible' ? 'Disponible para envío hoy' : 'Bajo pedido · 2 a 4 semanas';
const dot = state === 'disponible' ? 'bg-brass' : 'bg-line-strong';
---

<p class="flex items-center gap-2.5 text-[0.82rem] font-medium tracking-[0.01em]">
  <span class:list={['inline-block h-2 w-2 rounded-full', dot]} aria-hidden="true"></span>
  {label}
</p>
