---
import Icon from '@/components/Icon.astro';
---

<dialog id="product-form-modal" class="product-dialog">
  <div class="w-full bg-paper p-8">
    <div class="flex items-center justify-between border-b border-line pb-4">
      <h2 class="h-section !text-[1.1rem]" data-product-form-title>Agregar nuevo producto</h2>
      <button type="button" data-product-form-close aria-label="Cerrar" class="text-brass-ink hover:opacity-60">
        <Icon name="close" size={20} />
      </button>
    </div>

    <form class="mt-6 grid gap-4 sm:grid-cols-2" data-product-form novalidate>
      <input type="hidden" name="id" />

      <label class="flex flex-col gap-1.5 text-[0.85rem] sm:col-span-2">
        Nombre del producto
        <input type="text" name="name" required class="pf-input" />
      </label>

      <label class="flex flex-col gap-1.5 text-[0.85rem]">
        Marca <span class="text-brass-ink">(opcional)</span>
        <input type="text" name="brand" class="pf-input" />
      </label>

      <label class="flex flex-col gap-1.5 text-[0.85rem]">
        Precio (USD)
        <input type="number" name="price" required min="0" step="0.01" class="pf-input" />
      </label>

      <label class="flex flex-col gap-1.5 text-[0.85rem]">
        Categoría
        <select name="category" required class="pf-input" data-product-category>
          <option value="" disabled selected>Elige una categoría</option>
        </select>
      </label>

      <label class="flex flex-col gap-1.5 text-[0.85rem]">
        Subcategoría <span class="text-brass-ink">(opcional)</span>
        <select name="subcategory" class="pf-input" data-product-subcategory>
          <option value="">Sin subcategoría</option>
        </select>
      </label>

      <label class="flex flex-col gap-1.5 text-[0.85rem] sm:col-span-2">
        Descripción
        <textarea name="description" required rows="3" class="pf-input resize-y"></textarea>
      </label>

      <label class="flex flex-col gap-1.5 text-[0.85rem]">
        Stock (unidades)
        <input type="number" name="stock" required min="0" step="1" class="pf-input" />
      </label>

      <label class="flex flex-col gap-1.5 text-[0.85rem]">
        Imagen <span data-product-image-hint class="text-brass-ink">(requerida)</span>
        <input type="file" name="image" accept="image/*" class="pf-input" data-product-image-input />
      </label>

      <p class="hidden text-[0.82rem] text-red-800 sm:col-span-2" data-product-form-error role="alert"></p>

      <div class="mt-2 flex gap-3 sm:col-span-2">
        <button type="submit" class="btn btn--solid">
          <span data-product-form-submit-label>Guardar producto</span>
        </button>
        <button type="button" class="btn btn--outline" data-product-form-cancel>Cancelar</button>
      </div>
    </form>
  </div>
</dialog>

<style>
  .product-dialog {
    width: 100%;
    max-width: 34rem;
    margin-top: 5vh;
    max-height: 90vh;
    overflow-y: auto;
    border: none;
    padding: 0;
    opacity: 0;
    transform: scale(0.97) translateY(6px);
    transition: opacity 300ms ease-in-out, transform 300ms ease-in-out;
  }
  .product-dialog[data-open] {
    opacity: 1;
    transform: none;
  }
  .product-dialog::backdrop {
    background: rgba(26, 23, 20, 0);
    transition: background-color 300ms ease-in-out;
  }
  .product-dialog[data-open]::backdrop {
    background: rgba(26, 23, 20, 0.55);
  }
  @media (prefers-reduced-motion: reduce) {
    .product-dialog,
    .product-dialog::backdrop {
      transition: none;
    }
  }
  .pf-input {
    border: 1px solid theme('colors.line-strong');
    background: theme('colors.bone');
    padding: 0.6rem 0.75rem;
    font-size: 0.92rem;
  }
  .pf-input:focus-visible {
    outline: 2px solid theme('colors.brass');
    outline-offset: 1px;
  }
</style>
