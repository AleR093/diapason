---
import { SITE } from '@/config';
import Icon from '@/components/Icon.astro';

interface Props {
  /** Home hero: nav floats over the image instead of sitting in a solid bar. */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const wordmark = SITE.name.toUpperCase().split('').join(' ');
---

<header
  class:list={[
    'z-50 w-full',
    overlay
      ? 'absolute inset-x-0 top-0 text-paper before:pointer-events-none before:absolute before:inset-x-0 before:top-0 before:h-32 before:bg-gradient-to-b before:from-ink/45 before:to-transparent'
      : 'sticky top-0 border-b border-line bg-surface-glass text-content backdrop-blur-md',
  ]}
  data-nav
>
  <div class="shell relative flex items-center gap-4 py-4 md:py-5">
    <a
      href="/"
      class:list={[
        'shrink-0 whitespace-nowrap text-[0.95rem] tracking-wordmark',
        overlay ? 'font-semibold [text-shadow:0_1px_12px_rgba(26,23,20,0.35)]' : 'font-medium',
      ]}
      aria-label={`${SITE.name} — inicio`}
    >
      {wordmark}
    </a>

    <!-- Buscador estilo YouTube: centrado, ancho, con la lupa integrada. Es un
         disparador (abre SearchModal, que ya trae el input real + resultados
         en vivo) en vez de duplicar esa lógica de búsqueda aquí. -->
    <button
      type="button"
      data-open-search
      class="search-bar mx-auto hidden max-w-md flex-1 items-center gap-3 rounded-full bg-surface-raised px-5 py-2.5 text-left text-[0.88rem] text-content/55 transition-colors hover:text-content md:flex"
    >
      <Icon name="search" size={17} class="shrink-0" />
      <span class="truncate">Buscar instrumentos, marcas, categorías…</span>
    </button>

    <div class="ml-auto flex shrink-0 items-center gap-2">
      <!-- Mobile-only: the dock below is lg:flex, so small screens keep quick
           access to the cart plus the full menu (which also lists favoritos,
           categorías, cuenta y el Modo Noche). -->
      <button type="button" data-open-cart aria-label="Carrito" class="relative p-1 lg:hidden">
        <Icon name="bag" size={19} />
        <span
          data-cart-count
          data-empty="true"
          class="u-tabular absolute -right-1 -top-1 min-w-[1.05rem] rounded-full bg-brass px-1 text-center text-[0.62rem] font-semibold leading-[1.05rem] text-paper"
        >0</span>
      </button>
      <button type="button" data-menu-open aria-expanded="false" aria-controls="mobile-menu" class="p-1 lg:hidden">
        <Icon name="menu" size={22} label="Abrir menú" />
      </button>
    </div>
  </div>
</header>

<!-- Menú lateral de iconos: dock flotante y vertical (reemplaza la barra de
     accesos rápidos horizontal). Solo desktop — en móvil, esos mismos accesos
     viven en el menú de pantalla completa de abajo. -->
<div class="pointer-events-none fixed inset-y-0 right-0 z-40 hidden items-center lg:flex" data-icon-dock>
  <div class="dock pointer-events-auto relative mr-4 flex flex-col items-center gap-1 rounded-full p-2">
    <div class="relative">
      <button
        type="button"
        data-dock-categories
        aria-expanded="false"
        aria-label="Categorías"
        class="dock-btn"
      >
        <Icon name="grid" size={18} />
      </button>
      <div
        class="absolute right-[calc(100%+0.75rem)] top-1/2 hidden w-52 -translate-y-1/2 flex-col gap-1 rounded-2xl border border-line bg-surface-raised p-3 shadow-[0_12px_40px_-20px_rgba(0,0,0,0.35)]"
        data-dock-categories-panel
      >
        <p class="px-2 pb-1 text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-brass-ink">Categorías</p>
        {SITE.nav.map((item) => (
          <a href={item.href} class="rounded-lg px-2 py-1.5 text-[0.88rem] hover:bg-felt">{item.label}</a>
        ))}
        <a href="/catalogo" class="rounded-lg px-2 py-1.5 text-[0.82rem] font-medium text-brass-ink">
          Todo el catálogo
        </a>
        <button
          type="button"
          data-theme-toggle
          aria-pressed="false"
          aria-label="Cambiar a modo noche"
          class="mt-1 flex items-center gap-2.5 rounded-lg border-t border-line px-2 pt-2.5 text-[0.88rem] hover:bg-felt"
        >
          <span class="theme-toggle relative inline-grid h-4 w-4 shrink-0 place-items-center">
            <Icon name="sun" size={15} data-icon-sun />
            <Icon name="moon" size={14} data-icon-moon />
          </span>
          Modo noche
        </button>
      </div>
    </div>

    <a href="/cuenta#favoritos" aria-label="Favoritos" class="dock-btn relative">
      <Icon name="heart" size={18} />
      <span
        data-wishlist-count
        data-empty="true"
        class="u-tabular absolute -right-0.5 -top-0.5 min-w-[1.05rem] rounded-full bg-brass px-1 text-center text-[0.62rem] font-semibold leading-[1.05rem] text-paper"
      >0</span>
    </a>

    <a href="/cuenta" aria-label="Mi cuenta" class="dock-btn">
      <span data-nav-avatar data-avatar-size="18"><Icon name="user" size={18} /></span>
    </a>

    <button type="button" data-open-cart aria-label="Carrito" class="dock-btn relative">
      <Icon name="bag" size={18} />
      <span
        data-cart-count
        data-empty="true"
        class="u-tabular absolute -right-0.5 -top-0.5 min-w-[1.05rem] rounded-full bg-brass px-1 text-center text-[0.62rem] font-semibold leading-[1.05rem] text-paper"
      >0</span>
    </button>
  </div>
</div>

<!-- Mobile menu -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] hidden bg-surface text-content"
  data-menu-panel
>
  <div class="shell flex items-center justify-between py-4">
    <span class="text-[0.95rem] font-medium tracking-wordmark">{wordmark}</span>
    <button type="button" data-menu-close aria-label="Cerrar menú" class="p-1">
      <Icon name="close" size={24} />
    </button>
  </div>
  <nav aria-label="Menú principal" class="shell mt-6">
    <ul class="flex flex-col gap-1">
      {SITE.nav.map((item) => (
        <li>
          <a href={item.href} class="h-section block border-b border-line py-4 !text-[1.4rem]">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-8 flex flex-col gap-4 text-[0.95rem]">
      <a href="/catalogo" class="btn btn--outline w-fit">Todo el catálogo</a>
      <button type="button" data-open-search class="flex items-center gap-2 text-brass-ink">
        <Icon name="search" size={16} />Buscar en el catálogo
      </button>
      <a href="/cuenta#favoritos" class="flex items-center gap-2 text-brass-ink">
        <Icon name="heart" size={16} />Favoritos
        <span
          data-wishlist-count
          data-empty="true"
          class="u-tabular min-w-[1.1rem] rounded-full bg-brass px-1 text-center text-[0.68rem] font-semibold leading-[1.1rem] text-paper"
        >0</span>
      </a>
      <a href="/cuenta" class="flex items-center gap-2 text-brass-ink">
        <span data-nav-avatar data-avatar-size="18"><Icon name="user" size={16} /></span>Mi cuenta
      </a>
      <a href={`tel:${SITE.phone.replace(/[\s-]/g, '')}`} class="flex items-center gap-2 text-brass-ink">
        <Icon name="phone" size={16} />{SITE.phone}
      </a>
      <button
        type="button"
        data-theme-toggle
        aria-pressed="false"
        aria-label="Cambiar a modo noche"
        class="flex items-center gap-2 border-t border-line pt-4 text-brass-ink"
      >
        <span class="theme-toggle relative inline-grid h-4 w-4 shrink-0 place-items-center">
          <Icon name="sun" size={15} data-icon-sun />
          <Icon name="moon" size={14} data-icon-moon />
        </span>
        Modo noche
      </button>
    </div>
  </nav>
</div>

<style>
  [data-cart-count][data-empty='true'],
  [data-wishlist-count][data-empty='true'] {
    display: none;
  }

  .search-bar {
    border: 1px solid theme('colors.line');
  }

  .dock {
    background-color: theme('colors.surface-glass');
    border: 1px solid theme('colors.line');
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .dock-btn {
    display: grid;
    place-items: center;
    height: 2.5rem;
    width: 2.5rem;
    border-radius: 9999px;
    color: theme('colors.content');
    transition: background-color 160ms ease;
  }

  .dock-btn:hover {
    background-color: theme('colors.felt');
  }
</style>

<script>
  import { openCartDrawer } from '@/scripts/cart';
  import { getAuthState, onAuthChange } from '@/lib/supabase/auth';
  import { avatarHTML } from '@/scripts/avatar-render';

  // Nav is shared layout markup: view transitions replace it wholesale on
  // every navigation, so this whole setup re-runs from scratch each time
  // (see the astro:page-load registration at the bottom).
  let unsubscribeAuth: (() => void) | null = null;

  function init() {
    const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
    const openBtns = document.querySelectorAll<HTMLButtonElement>('[data-menu-open]');
    const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');

    function setOpen(open: boolean) {
      if (!panel) return;
      panel.classList.toggle('hidden', !open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
      openBtns.forEach((b) => b.setAttribute('aria-expanded', String(open)));
      if (open) {
        panel.querySelector<HTMLElement>('a, button')?.focus();
      }
    }

    openBtns.forEach((b) => b.addEventListener('click', () => setOpen(true)));
    closeBtn?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });

    document.querySelectorAll<HTMLButtonElement>('[data-open-search]').forEach((btn) => {
      btn.addEventListener('click', () => {
        setOpen(false);
        window.dispatchEvent(new CustomEvent('diapason:open-search'));
      });
    });
    document.querySelectorAll<HTMLButtonElement>('[data-open-cart]').forEach((btn) => {
      btn.addEventListener('click', () => openCartDrawer());
    });

    // Dock's "Categorías" flyout — same open/outside-click/Escape pattern as
    // the mobile menu, scoped to its own small panel instead of the full screen.
    const catBtn = document.querySelector<HTMLButtonElement>('[data-dock-categories]');
    const catPanel = document.querySelector<HTMLElement>('[data-dock-categories-panel]');
    function setCatOpen(open: boolean) {
      if (!catBtn || !catPanel) return;
      catPanel.classList.toggle('hidden', !open);
      catPanel.classList.toggle('flex', open);
      catBtn.setAttribute('aria-expanded', String(open));
    }
    catBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      setCatOpen(catPanel?.classList.contains('hidden') ?? true);
    });
    document.addEventListener('click', (e) => {
      if (catPanel && !catPanel.classList.contains('hidden') && !catPanel.contains(e.target as Node)) {
        setCatOpen(false);
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setCatOpen(false);
    });

    // Account icon: the signed-in shopper's photo (or initials) instead of
    // the generic outline, restored to the outline on sign-out.
    const avatarSlots = [...document.querySelectorAll<HTMLElement>('[data-nav-avatar]')];
    const defaultIconHTML = avatarSlots.map((slot) => slot.innerHTML);

    function renderAccount() {
      const state = getAuthState();
      avatarSlots.forEach((slot, i) => {
        if (state.session) {
          const size = Number(slot.dataset.avatarSize || 20);
          slot.innerHTML = avatarHTML({
            avatarUrl: state.profile?.avatar_url,
            name: state.profile?.full_name,
            email: state.session.user.email,
            size,
          });
        } else {
          slot.innerHTML = defaultIconHTML[i];
        }
      });
    }

    unsubscribeAuth?.();
    unsubscribeAuth = onAuthChange(renderAccount);
    renderAccount();
  }

  document.addEventListener('astro:page-load', init);
</script>
