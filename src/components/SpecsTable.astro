---
import type { Spec } from '@/lib/types';

interface Props {
  specs: Spec[];
}
const { specs } = Astro.props;
---

<dl class="border-t border-line">
  {specs.map((spec) => (
    <div class="grid grid-cols-[minmax(0,10rem)_1fr] gap-4 border-b border-line py-3">
      <dt class="text-[0.82rem] font-medium tracking-[0.01em] text-brass-ink">{spec.label}</dt>
      <dd class="text-[0.9rem] leading-relaxed">{spec.value}</dd>
    </div>
  ))}
</dl>
