---
interface Props {
  href: string;
  active?: boolean;
  [key: `data-${string}`]: string | undefined;
}
const { href, active = false, ...rest } = Astro.props;
---

<a href={href} class="chip" data-active={active ? 'true' : 'false'} aria-current={active ? 'true' : undefined} {...rest}>
  <slot />
</a>
