---
import type { Category, Product } from '@/lib/types';
import ProductCard from '@/components/ProductCard.astro';
import Chip from '@/components/Chip.astro';
import Icon from '@/components/Icon.astro';

interface Props {
  category: Category;
  products: Product[];
  brands: string[];
  activeSub?: string;
}

const { category, products, brands, activeSub } = Astro.props;
const base = `/catalogo/${category.slug}`;
const activeName = activeSub
  ? category.subcategories.find((s) => s.slug === activeSub)?.name
  : undefined;
---

<div class="shell pb-4 pt-12 md:pt-16">
  <nav aria-label="Migas" class="text-[0.78rem] tracking-[0.02em] text-brass-ink">
    <a href="/catalogo" class="hover:underline">Catálogo</a>
    <span aria-hidden="true"> / </span>
    <a href={base} class="hover:underline">{category.name}</a>
    {activeName && (<Fragment><span aria-hidden="true"> / </span>{activeName}</Fragment>)}
  </nav>

  <h1 class="h-section mt-4">{activeName ?? category.name}</h1>
  <p class="prose-editorial mt-4 !text-[1.05rem]">{category.blurb}</p>

  <div class="mt-8 flex flex-wrap gap-2">
    <Chip href={base} active={!activeSub}>Todo</Chip>
    {category.subcategories.map((sub) => (
      <Chip href={`${base}/${sub.slug}`} active={activeSub === sub.slug}>{sub.name}</Chip>
    ))}
  </div>

  <div class="mt-8 flex items-center justify-between gap-4 border-t border-line pt-6">
    <p class="u-tabular text-[0.82rem] font-medium tracking-[0.02em] text-brass-ink" data-result-count>
      {products.length} {products.length === 1 ? 'resultado' : 'resultados'}
    </p>

    {brands.length > 1 && (
      <details class="group/filter relative" data-filter>
        <summary
          class="btn btn--outline cursor-pointer list-none [&::-webkit-details-marker]:hidden"
        >
          <Icon name="filter" size={15} /> Filtrar
        </summary>
        <div
          class="absolute right-0 z-30 mt-2 w-64 border border-line bg-paper p-5 shadow-[0_12px_40px_-24px_rgba(26,23,20,0.5)]"
        >
          <p class="text-[0.78rem] font-semibold uppercase tracking-[0.12em] text-brass-ink">Marca</p>
          <ul class="mt-3 flex flex-col gap-2.5">
            {brands.map((brand) => (
              <li>
                <label class="flex cursor-pointer items-center gap-2.5 text-[0.9rem]">
                  <input type="checkbox" value={brand} data-brand-filter class="accent-ink" />
                  {brand}
                </label>
              </li>
            ))}
          </ul>
          <button type="button" class="btn btn--link mt-4" data-filter-clear>Quitar filtros</button>
        </div>
      </details>
    )}
  </div>

  <div
    class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 md:gap-x-6 lg:grid-cols-4"
    data-grid
  >
    {products.map((product, i) => (
      <div data-item data-brand={product.brand}>
        <ProductCard product={product} loading={i < 8 ? 'eager' : 'lazy'} />
      </div>
    ))}
    <p class="col-span-full hidden py-10 text-[0.9rem] text-brass-ink" data-empty-state>
      Ninguna pieza coincide con esos filtros.
      <a href={base} class="underline">Ver todo {category.name.toLowerCase()}</a>.
    </p>
  </div>

  <div class="prose-editorial mt-16 border-t border-line pt-10">
    <h2 class="h-section !text-[1.2rem]">Comprar {category.name.toLowerCase()} en Diapasón</h2>
    <p class="mt-4">{category.intro}</p>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-filter]');
  if (root) {
    const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
    const boxes = [...document.querySelectorAll<HTMLInputElement>('[data-brand-filter]')];
    const count = document.querySelector<HTMLElement>('[data-result-count]');
    const empty = document.querySelector<HTMLElement>('[data-empty-state]');
    const clear = document.querySelector<HTMLButtonElement>('[data-filter-clear]');

    const apply = () => {
      const active = boxes.filter((b) => b.checked).map((b) => b.value);
      let shown = 0;
      items.forEach((item) => {
        const match = active.length === 0 || active.includes(item.dataset.brand ?? '');
        item.hidden = !match;
        if (match) shown += 1;
      });
      if (count) count.textContent = `${shown} ${shown === 1 ? 'resultado' : 'resultados'}`;
      if (empty) empty.hidden = shown !== 0;
    };

    boxes.forEach((b) => b.addEventListener('change', apply));
    clear?.addEventListener('click', () => {
      boxes.forEach((b) => (b.checked = false));
      apply();
      root.removeAttribute('open');
    });
    document.addEventListener('click', (e) => {
      if (root.hasAttribute('open') && !root.contains(e.target as Node)) root.removeAttribute('open');
    });
  }
</script>
