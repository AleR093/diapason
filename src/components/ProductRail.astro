---
import type { Product } from '@/lib/types';
import ProductCard from '@/components/ProductCard.astro';

interface Props {
  products: Product[];
  labelledby?: string;
}

const { products, labelledby } = Astro.props;
---

<div class="edge-fade-r -mx-5 md:-mx-10 xl:-mx-14">
  <ul
    class="rail flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-1 md:gap-6 md:px-10 xl:px-14"
    aria-labelledby={labelledby}
  >
    {products.map((product, i) => (
      <li>
        <ProductCard product={product} inRail loading={i < 3 ? 'eager' : 'lazy'} />
      </li>
    ))}
  </ul>
</div>
