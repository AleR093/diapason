---
import Button from '@/components/Button.astro';
import { whatsappLink } from '@/config';
import { unsplash, FELT_PLACEHOLDER } from '@/lib/img';

const heroImg = unsplash('1525201548942-d8732f6617a0', 1800, '16/9');

const title = 'El instrumento correcto, afinado antes de llegar a tus manos.';

/**
 * Typewriter reveal, built at Astro's build time (this frontmatter runs once,
 * server-side) rather than in client JS: each character gets its own <span>
 * with a staggered animation-delay, and global.css does the rest with pure
 * CSS (.tw-w / .tw-c). Words are wrapped too, so a line break only ever lands
 * between words, never mid-word.
 *
 * Because Astro's view transitions swap the whole <body> on every navigation,
 * this markup (and its CSS animation) is freshly inserted each time "/"
 * loads — so the effect "replays" on every visit to the homepage, same as
 * the existing .hero-img settle animation below.
 */
const STEP_MS = 22;
let charIndex = 0;
const titleHTML = title
  .split(' ')
  .map((word) => {
    const chars = [...word]
      .map((ch) => {
        const span = `<span class="tw-c" style="animation-delay:${charIndex * STEP_MS}ms">${ch}</span>`;
        charIndex += 1;
        return span;
      })
      .join('');
    charIndex += 1; // the space after this word gets its own beat too
    return `<span class="tw-w">${chars}</span>`;
  })
  .join(' ');
---

<section
  class="hero relative flex min-h-[100svh] items-center justify-center overflow-hidden bg-walnut"
  data-hero
>
  <img
    src={heroImg}
    alt="Guitarrista con una acústica, sentado en el taller"
    width="1800"
    height="1013"
    fetchpriority="high"
    class="hero-img absolute inset-0 h-full w-full object-cover"
    data-hero-img
    onerror={`this.onerror=null;this.src='${FELT_PLACEHOLDER}'`}
  />
  <!-- Fixed base scrim (always on, for text legibility) + a second layer whose
       opacity the scroll-fade script drives independently — see the <script>
       below and the reduced-motion guard in it. -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-ink/60 via-ink/35 to-ink/85" aria-hidden="true"></div>
  <div class="hero-scroll-scrim pointer-events-none absolute inset-0 bg-ink opacity-0" data-hero-scrim aria-hidden="true"></div>

  <div class="shell relative flex flex-col items-center px-5 py-28 text-center text-paper md:py-32">
    <p class="h-display max-w-[16ch] text-paper" set:html={titleHTML} />
    <p class="prose-editorial on-dark mt-6 max-w-[46ch] !text-[1.05rem]">
      Guitarras, teclados, vientos, percusión y equipo de audio. Cada pieza se revisa
      en nuestro taller y llega con sus especificaciones completas.
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <Button href="/catalogo" variant="solid" icon="arrow-right">Ver el catálogo</Button>
      <Button href={whatsappLink()} variant="outline" onDark>Consultar por WhatsApp</Button>
    </div>

    <!-- Loaded live from Supabase (most recent product); stays hidden if the
         catalog is empty or unreachable, so the hero never shows a placeholder. -->
    <a
      href="/catalogo"
      class="mt-12 hidden w-full max-w-md items-center gap-4 rounded-2xl border border-paper/15 bg-paper/10 p-4 text-left backdrop-blur-md"
      data-hero-feature
    >
      <div class="h-16 w-14 shrink-0 overflow-hidden rounded-md bg-felt">
        <img
          data-hero-feature-img
          alt=""
          width="56"
          height="64"
          class="h-full w-full object-cover"
          onerror={`this.onerror=null;this.src='${FELT_PLACEHOLDER}'`}
        />
      </div>
      <div class="min-w-0 flex-1">
        <p class="text-[0.7rem] font-medium uppercase tracking-[0.14em] text-paper/70" data-hero-feature-label>
          Recién llegado
        </p>
        <p class="truncate text-[0.92rem] font-medium text-paper underline-offset-4 hover:underline" data-hero-feature-name></p>
        <p class="u-tabular text-[0.85rem] text-paper/80" data-hero-feature-price></p>
      </div>
      <span class="btn btn--outline on-dark shrink-0 !text-[0.7rem]" aria-hidden="true">Ver ficha</span>
    </a>
  </div>
</section>

<style>
  /* One quiet entrance: the hero image resolves from a slight zoom + fade. Runs once. */
  .hero-img {
    animation: hero-settle 1100ms cubic-bezier(0.22, 1, 0.36, 1) both;
    transition: opacity 120ms linear;
  }
  @keyframes hero-settle {
    from {
      transform: scale(1.05);
    }
    to {
      transform: none;
    }
  }
  .hero-scroll-scrim {
    transition: opacity 120ms linear;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-img {
      animation: none;
    }
  }
</style>

<script>
  import { listProducts } from '@/lib/supabase/products';
  import { formatPriceJS } from '@/scripts/product-render';
  import { FELT_PLACEHOLDER } from '@/lib/img';

  // Hero only lives on "/", but view transitions can bring you back to it
  // more than once per session — astro:page-load re-runs this every time.
  function init() {
    const feature = document.querySelector<HTMLAnchorElement>('[data-hero-feature]');
    if (feature) {
      // listProducts() already orders by created_at desc, so limit:1 is the newest item.
      listProducts({ limit: 1 }).then(({ data }) => {
        const product = data?.[0];
        if (!product) return;

        feature.href = `/producto?slug=${encodeURIComponent(product.slug)}`;

        const img = feature.querySelector<HTMLImageElement>('[data-hero-feature-img]');
        if (img) {
          img.src = product.images[0] || FELT_PLACEHOLDER;
          img.alt = product.name;
        }
        const label = feature.querySelector('[data-hero-feature-label]');
        if (label) label.textContent = product.is_new ? 'Recién llegado' : 'Selección de la semana';
        const name = feature.querySelector('[data-hero-feature-name]');
        if (name) name.textContent = product.brand ? `${product.brand} ${product.name}` : product.name;
        const price = feature.querySelector('[data-hero-feature-price]');
        if (price) price.textContent = formatPriceJS(product.price);

        feature.classList.remove('hidden');
        feature.classList.add('flex');
      });
    }

    // Scroll fade: the background photo loses opacity and darkens smoothly as
    // the user scrolls past the hero. rAF-throttled; skipped entirely under
    // prefers-reduced-motion (the image just stays put).
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const img = document.querySelector<HTMLElement>('[data-hero-img]');
    const scrim = document.querySelector<HTMLElement>('[data-hero-scrim]');
    if (!hero || !img || !scrim) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let ticking = false;
    function update() {
      ticking = false;
      const h = hero!.offsetHeight || 1;
      const progress = Math.min(Math.max(window.scrollY / h, 0), 1);
      img!.style.opacity = String(1 - progress * 0.6);
      scrim!.style.opacity = String((progress * 0.6).toFixed(2));
    }
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  }

  document.addEventListener('astro:page-load', init);
</script>
