---
import Base from '@/layouts/Base.astro';
import CatalogListing from '@/components/CatalogListing.astro';
import { getCategories } from '@/lib/catalog';

export function getStaticPaths() {
  return getCategories().flatMap((category) =>
    category.subcategories.map((sub) => ({
      params: { category: category.slug, sub: sub.slug },
      props: { category, sub },
    })),
  );
}

const { category, sub } = Astro.props;
---

<Base
  title={`${sub.name} · ${category.name}`}
  description={`${sub.name} en la sección de ${category.name.toLowerCase()} de Diapasón.`}
>
  <CatalogListing category={category} activeSub={sub.slug} />
</Base>
