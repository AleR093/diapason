---
import Base from '@/layouts/Base.astro';
import CatalogListing from '@/components/CatalogListing.astro';
import { getCategories, getProductsByCategory, getBrandsInCategory } from '@/lib/catalog';

export function getStaticPaths() {
  return getCategories().map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const products = getProductsByCategory(category.slug);
const brands = getBrandsInCategory(category.slug);
---

<Base
  title={category.name}
  description={`${category.name} en Diapasón — ${category.blurb}`}
>
  <CatalogListing category={category} products={products} brands={brands} />
</Base>
