---
import Base from '@/layouts/Base.astro';
import CategoryTile from '@/components/CategoryTile.astro';
import ProductCard from '@/components/ProductCard.astro';
import Chip from '@/components/Chip.astro';
import { getCategories, getProducts } from '@/lib/catalog';

const categories = getCategories();
const all = getProducts();

const soloNuevos = Astro.url.searchParams.get('filtro') === 'nuevos';
const products = soloNuevos ? all.filter((p) => p.isNew) : all;
---

<Base
  title="Catálogo"
  description="Todo el catálogo de Diapasón: guitarras, teclados, vientos, percusión y equipo de audio, con especificaciones y disponibilidad."
>
  <div class="shell pb-16 pt-12 md:pt-16">
    <h1 class="h-section">Catálogo</h1>
    <p class="prose-editorial mt-4 !text-[1.05rem]">
      {all.length} instrumentos y equipos, cada uno con su ficha técnica. Empieza por una
      familia o revisa las novedades.
    </p>

    <div class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4 lg:grid-cols-5">
      {categories.map((category, i) => (
        <CategoryTile category={category} loading={i < 5 ? 'eager' : 'lazy'} />
      ))}
    </div>

    <div class="mt-16 flex flex-wrap items-end justify-between gap-4 border-t border-line pt-8">
      <h2 class="h-section !text-[1.35rem]">
        {soloNuevos ? 'Novedades' : 'Todo el catálogo'}
      </h2>
      <div class="flex gap-2">
        <Chip href="/catalogo" active={!soloNuevos}>Todo</Chip>
        <Chip href="/catalogo?filtro=nuevos" active={soloNuevos}>Novedades</Chip>
      </div>
    </div>

    <p class="u-tabular mt-6 text-[0.82rem] font-medium tracking-[0.02em] text-brass-ink">
      {products.length} {products.length === 1 ? 'resultado' : 'resultados'}
    </p>

    <div class="mt-6 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 md:gap-x-6 lg:grid-cols-4">
      {products.map((product, i) => (
        <ProductCard product={product} loading={i < 8 ? 'eager' : 'lazy'} />
      ))}
    </div>
  </div>
</Base>
