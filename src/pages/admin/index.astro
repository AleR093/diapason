---
import Base from '@/layouts/Base.astro';
import ProductFormModal from '@/components/ProductFormModal.astro';
---

<Base title="Panel de administración" description="Panel de administración de Diapasón.">
  <div class="shell py-16 md:py-20" data-auth-gate>
    <p data-gate-loading class="prose-editorial !text-[1.05rem]">Verificando acceso…</p>

    <div data-gate-signed-out hidden>
      <h1 class="h-section">Panel de administración</h1>
      <p class="prose-editorial mt-4 !text-[1.05rem]">
        Esta sección es solo para el equipo de Diapasón. Inicia sesión con una cuenta de administrador.
      </p>
      <button type="button" class="btn btn--solid mt-8" data-open-auth>Iniciar sesión</button>
    </div>

    <div data-gate-denied hidden>
      <h1 class="h-section">Acceso restringido</h1>
      <p class="prose-editorial mt-4 !text-[1.05rem]">
        Tu cuenta (<strong data-user-email></strong>) no tiene permisos de administrador. Si crees que es un
        error, pide a un administrador que actualice tu rol.
      </p>
      <a href="/" class="btn btn--outline mt-8">Volver al inicio</a>
    </div>

    <div data-gate-content hidden>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="h-section">Panel de administración</h1>
          <p class="prose-editorial mt-3 !text-[1.05rem]">
            Sesión de administrador: <strong data-user-email></strong>.
          </p>
        </div>
        <button type="button" class="btn btn--outline" data-sign-out>Cerrar sesión</button>
      </div>

      <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-8">
        <h2 class="h-section !text-[1.2rem]">Productos</h2>
        <button type="button" class="btn btn--solid" data-open-product-form>Agregar nuevo producto</button>
      </div>

      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[640px] text-left">
          <thead>
            <tr class="border-b border-line-strong text-[0.72rem] font-semibold uppercase tracking-[0.1em] text-brass-ink">
              <th class="pb-3 pr-4 font-semibold">Imagen</th>
              <th class="pb-3 pr-4 font-semibold">Producto</th>
              <th class="pb-3 pr-4 font-semibold">Categoría</th>
              <th class="pb-3 pr-4 font-semibold">Precio</th>
              <th class="pb-3 pr-4 font-semibold">Stock</th>
              <th class="pb-3 pr-4 font-semibold"></th>
            </tr>
          </thead>
          <tbody data-admin-products-body></tbody>
        </table>
        <p class="py-8 text-[0.9rem] text-brass-ink" data-admin-products-empty hidden>
          Todavía no hay productos. Usa "Agregar nuevo producto" para crear el primero.
        </p>
        <p class="py-8 text-[0.9rem] text-red-800" data-admin-products-error hidden>
          No se pudo cargar la lista de productos. Revisa que hayas corrido
          <code>supabase/products.sql</code> en tu proyecto de Supabase.
        </p>
      </div>
    </div>
  </div>

  <ProductFormModal />
</Base>

<script>
  import { initAuthGate } from '@/scripts/auth-gate';
  import { initAdminProducts } from '@/scripts/admin-products';

  initAuthGate({ requireAdmin: true });
  initAdminProducts();
</script>
