---
import Base from '@/layouts/Base.astro';
---

<Base title="Mi cuenta" description="Gestiona tu sesión en Diapasón.">
  <div class="shell py-16 md:py-20" data-auth-gate>
    <p data-gate-loading class="prose-editorial !text-[1.05rem]">Verificando tu sesión…</p>

    <div data-gate-signed-out hidden>
      <h1 class="h-section">Mi cuenta</h1>
      <p class="prose-editorial mt-4 !text-[1.05rem]">
        Inicia sesión para ver tus datos, o crea una cuenta si es tu primera compra.
      </p>
      <button type="button" class="btn btn--solid mt-8" data-open-auth>Iniciar sesión</button>
    </div>

    <div data-gate-content hidden>
      <h1 class="h-section">Mi cuenta</h1>

      <div class="mt-6 flex items-center gap-4">
        <div data-account-avatar></div>
        <div>
          <label class="btn btn--outline w-fit cursor-pointer">
            Cambiar foto
            <input type="file" accept="image/*" class="sr-only" data-avatar-input />
          </label>
          <p class="mt-2 text-[0.78rem] text-red-800" data-avatar-error hidden></p>
        </div>
      </div>

      <p class="prose-editorial mt-6 !text-[1.05rem]">
        Sesión iniciada como <strong data-user-email></strong>.
      </p>
      <p class="mt-3 text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-brass-ink" data-user-role></p>

      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/admin" class="btn btn--outline" data-admin-only hidden data-astro-reload>Panel de administración</a>
        <button type="button" class="btn btn--link" data-sign-out>Cerrar sesión</button>
      </div>
    </div>
  </div>

  <!-- Guardados en este navegador (localStorage) — no depende de tener sesión. -->
  <section class="shell border-t border-line py-16 md:py-20" id="favoritos">
    <h2 class="h-section !text-[1.2rem]">Favoritos</h2>
    <p class="prose-editorial mt-3 !text-[0.95rem]" data-wishlist-empty>
      Todavía no has guardado nada. Toca el corazón en cualquier producto para guardarlo aquí.
    </p>
    <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 md:gap-x-6 lg:grid-cols-4" data-wishlist-grid></div>
  </section>
</Base>

<script>
  import { initAuthGate } from '@/scripts/auth-gate';
  import { getAuthState, onAuthChange, updateAvatar } from '@/lib/supabase/auth';
  import { avatarHTML } from '@/scripts/avatar-render';
  import { getWishlist, onWishlistChange, type WishlistItem } from '@/scripts/wishlist';
  import { productCardHTML } from '@/scripts/product-render';
  import type { StoreProduct } from '@/lib/types';

  let unsubscribeAuth: (() => void) | null = null;
  let unsubscribeWishlist: (() => void) | null = null;

  /** Wishlist items only carry {id,slug,name,price,image} — pad the rest so productCardHTML() can render them. */
  function toStoreProduct(item: WishlistItem): StoreProduct {
    return {
      id: item.id,
      slug: item.slug,
      name: item.name,
      brand: null,
      category_slug: '',
      subcategory_slug: null,
      price: item.price,
      description: null,
      stock: 1,
      is_new: false,
      images: [item.image],
      specs: [],
      created_at: '',
    };
  }

  function init() {
    initAuthGate();

    const wishlistGrid = document.querySelector<HTMLElement>('[data-wishlist-grid]');
    const wishlistEmpty = document.querySelector<HTMLElement>('[data-wishlist-empty]');
    function renderWishlist() {
      const items = getWishlist();
      if (wishlistEmpty) wishlistEmpty.hidden = items.length !== 0;
      if (wishlistGrid) wishlistGrid.innerHTML = items.map((item) => productCardHTML(toStoreProduct(item))).join('');
    }
    unsubscribeWishlist?.();
    unsubscribeWishlist = onWishlistChange(renderWishlist);
    renderWishlist();

    const avatarSlot = document.querySelector<HTMLElement>('[data-account-avatar]');
    const avatarInput = document.querySelector<HTMLInputElement>('[data-avatar-input]');
    const avatarError = document.querySelector<HTMLElement>('[data-avatar-error]');
    if (!avatarSlot) return;

    function renderAvatar() {
      const { session, profile } = getAuthState();
      avatarSlot!.innerHTML = avatarHTML({
        avatarUrl: profile?.avatar_url,
        name: profile?.full_name,
        email: session?.user.email,
        size: 64,
      });
    }

    unsubscribeAuth?.();
    unsubscribeAuth = onAuthChange(renderAvatar);
    renderAvatar();

    avatarInput?.addEventListener('change', async () => {
      const file = avatarInput.files?.[0];
      if (!file) return;
      if (avatarError) avatarError.hidden = true;
      avatarInput.disabled = true;

      const { error } = await updateAvatar(file);

      avatarInput.disabled = false;
      avatarInput.value = '';
      if (error && avatarError) {
        avatarError.textContent = 'No se pudo actualizar tu foto: ' + error;
        avatarError.hidden = false;
      }
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
