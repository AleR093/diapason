---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
---

<Base title="Producto" description="Ficha de producto en Diapasón.">
  <div class="shell pt-10 md:pt-14" data-pdp>
    <p class="prose-editorial !text-[1.05rem]" data-pdp-loading>Cargando la ficha…</p>

    <div class="hidden" data-pdp-notfound>
      <p class="h-display max-w-[16ch]">No encontramos esta pieza.</p>
      <p class="prose-editorial mt-5">
        Puede que ya no esté disponible o que el enlace esté mal escrito.
      </p>
      <div class="mt-8">
        <Button href="/catalogo" variant="solid" icon="arrow-right">Ir al catálogo</Button>
      </div>
    </div>

    <div class="hidden" data-pdp-content>
      <nav aria-label="Migas" class="text-[0.78rem] tracking-[0.02em] text-brass-ink">
        <a href="/catalogo" class="hover:underline">Catálogo</a>
        <span aria-hidden="true"> / </span>
        <a href="/catalogo" data-pdp-category-link class="hover:underline" data-pdp-category-name></a>
        <span aria-hidden="true"> / </span>
        <span data-pdp-name></span>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
        <!-- Media -->
        <div class="flex flex-col gap-4" data-pdp-gallery></div>

        <!-- Detail -->
        <div class="lg:sticky lg:top-24 lg:h-fit">
          <p class="text-[0.78rem] font-medium uppercase tracking-[0.16em] text-brass-ink" data-pdp-brand></p>
          <h1 class="mt-2 text-[1.7rem] font-semibold leading-tight md:text-[2rem]" data-pdp-title></h1>
          <p class="u-tabular mt-3 text-[1.15rem] font-medium" data-pdp-price></p>

          <p class="prose-editorial mt-6 !text-[1.02rem]" data-pdp-description></p>

          <div class="mt-8" data-pdp-stock></div>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <Button variant="solid" class="justify-center sm:justify-start" data-pdp-add-to-cart>
              <span data-add-label>Añadir al carrito</span>
            </Button>
            <Button
              href="#configura-whatsapp"
              variant="outline"
              icon="whatsapp"
              class="justify-center sm:justify-start"
              data-pdp-whatsapp
            >
              Consultar disponibilidad
            </Button>
          </div>

          <div class="mt-12 hidden" data-pdp-specs-wrap>
            <h2 class="h-section !text-[1.05rem]">Especificaciones</h2>
            <dl class="mt-4 border-t border-line" data-pdp-specs></dl>
          </div>

          <p class="mt-8 text-[0.82rem] leading-relaxed text-brass-ink">
            Incluye ajuste inicial en taller y garantía de 12 meses. Envío a todo el país;
            entrega estimada de 2 a 5 días hábiles en compras con stock.
          </p>
        </div>
      </div>

      <!-- Reseñas -->
      <section class="mt-16 border-t border-line pt-12 md:mt-24" data-pdp-reviews aria-labelledby="reviews-h">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 id="reviews-h" class="h-section !text-[1.2rem]">Opiniones</h2>
          <div class="flex items-center gap-2" data-reviews-summary>
            <div class="flex gap-0.5" data-reviews-stars aria-hidden="true"></div>
            <p class="text-[0.85rem] font-medium text-brass-ink" data-reviews-count>Sin opiniones todavía</p>
          </div>
        </div>

        <div class="mt-8 grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
          <form class="flex flex-col gap-4" data-review-form novalidate>
            <div>
              <p class="text-[0.78rem] font-medium uppercase tracking-[0.1em] text-brass-ink">Tu calificación</p>
              <div
                class="mt-2 flex gap-1"
                data-review-stars-picker
                role="radiogroup"
                aria-label="Calificación de 1 a 5 estrellas"
              >
                {[1, 2, 3, 4, 5].map((n) => (
                  <button
                    type="button"
                    class="review-star text-brass/30 transition-colors hover:text-brass"
                    data-star={n}
                    aria-label={`${n} estrella${n > 1 ? 's' : ''}`}
                    aria-pressed="false"
                  >
                    <Icon name="star" size={22} />
                  </button>
                ))}
              </div>
              <input type="hidden" data-review-rating-input value="0" />
            </div>
            <label class="flex flex-col gap-1.5 text-[0.85rem]">
              Tu nombre <span class="text-brass-ink">(opcional)</span>
              <input type="text" class="rv-input" data-review-author placeholder="Cliente Anónimo" />
            </label>
            <label class="flex flex-col gap-1.5 text-[0.85rem]">
              Tu opinión
              <textarea
                class="rv-input resize-y"
                rows="4"
                data-review-comment
                placeholder="Cuéntanos qué te pareció esta pieza"
              ></textarea>
            </label>
            <p class="text-[0.82rem] text-red-800" data-review-error hidden></p>
            <p class="text-[0.82rem] text-brass-ink" data-review-success hidden>Gracias por tu opinión.</p>
            <Button type="submit" variant="solid" class="w-fit justify-center">Publicar reseña</Button>
          </form>

          <div data-reviews-list>
            <p class="prose-editorial !text-[0.95rem]" data-reviews-empty>
              Sé el primero en dejar una opinión sobre esta pieza.
            </p>
            <div class="flex flex-col gap-6" data-reviews-items></div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <section class="mt-24 hidden md:mt-32" data-pdp-related>
    <div class="shell">
      <h2 id="rel-h" class="h-section">También te puede interesar</h2>
    </div>
    <div class="shell mt-10" data-pdp-related-slot aria-labelledby="rel-h"></div>
  </section>
</Base>

<style>
  .rv-input {
    border: 1px solid theme('colors.line-strong');
    background: theme('colors.bone');
    padding: 0.65rem 0.8rem;
    font-size: 0.9rem;
  }
  .rv-input:focus-visible {
    outline: 2px solid theme('colors.brass');
    outline-offset: 1px;
  }
</style>

<script>
  import { getProductBySlug, getRelatedProducts } from '@/lib/supabase/products';
  import { productRailHTML, formatPriceJS, escapeHtml, productImageTransitionName } from '@/scripts/product-render';
  import { getReviewsByProduct, addReview } from '@/lib/supabase/reviews';
  import type { Review } from '@/lib/supabase/reviews';
  import { starsHTML, reviewRowHTML } from '@/scripts/review-render';
  import { getAuthState, onAuthChange } from '@/lib/supabase/auth';
  import { whatsappLink } from '@/config';
  import { FELT_PLACEHOLDER } from '@/lib/img';
  import { getCategoryBySlug } from '@/lib/supabase/categories';
  import type { Spec } from '@/lib/types';

  // ?slug= only exists at runtime, and re-clicking to another /producto?slug=
  // is a same-route view-transition navigation Astro won't re-run this script
  // for on its own — astro:page-load (fired on every navigation, including
  // the first) is what makes that work. See dialog-transitions.ts's sibling
  // comment pattern for the same idea applied to shared modals.
  let unsubscribeAuth: (() => void) | null = null;

  function init() {
    const root = document.querySelector<HTMLElement>('[data-pdp]');
    if (!root) return;

    const loading = root.querySelector<HTMLElement>('[data-pdp-loading]');
    const notFound = root.querySelector<HTMLElement>('[data-pdp-notfound]');
    const content = root.querySelector<HTMLElement>('[data-pdp-content]');

    const slug = new URLSearchParams(location.search).get('slug');

    function show(el: HTMLElement | null) {
      [loading, notFound, content].forEach((e) => e?.classList.toggle('hidden', e !== el));
    }

    // Reseñas — wired here so it's ready the moment the product resolves below.
    const reviewForm = root.querySelector<HTMLFormElement>('[data-review-form]');
    const reviewStars = [...root.querySelectorAll<HTMLButtonElement>('.review-star')];
    const reviewRatingInput = root.querySelector<HTMLInputElement>('[data-review-rating-input]');
    const reviewAuthorInput = root.querySelector<HTMLInputElement>('[data-review-author]');
    const reviewCommentInput = root.querySelector<HTMLTextAreaElement>('[data-review-comment]');
    const reviewError = root.querySelector<HTMLElement>('[data-review-error]');
    const reviewSuccess = root.querySelector<HTMLElement>('[data-review-success]');
    const reviewsStarsEl = root.querySelector<HTMLElement>('[data-reviews-stars]');
    const reviewsCountEl = root.querySelector<HTMLElement>('[data-reviews-count]');
    const reviewsEmptyEl = root.querySelector<HTMLElement>('[data-reviews-empty]');
    const reviewsItemsEl = root.querySelector<HTMLElement>('[data-reviews-items]');

    function setRating(n: number) {
      if (reviewRatingInput) reviewRatingInput.value = String(n);
      reviewStars.forEach((s) => {
        const val = Number(s.dataset.star);
        s.classList.toggle('text-brass', val <= n);
        s.classList.toggle('text-brass/30', val > n);
        s.setAttribute('aria-pressed', String(val <= n));
      });
    }
    reviewStars.forEach((s) => s.addEventListener('click', () => setRating(Number(s.dataset.star))));

    // Prefills the name field for a signed-in shopper without locking the field —
    // never overwrites something the person already typed.
    function applyAuthorFromSession() {
      if (!reviewAuthorInput || reviewAuthorInput.value) return;
      const { profile } = getAuthState();
      if (profile?.full_name) reviewAuthorInput.value = profile.full_name;
    }
    applyAuthorFromSession();
    unsubscribeAuth?.();
    unsubscribeAuth = onAuthChange(applyAuthorFromSession);

    function renderReviewSummary(reviews: Review[]) {
      if (!reviews.length) {
        if (reviewsStarsEl) reviewsStarsEl.innerHTML = '';
        if (reviewsCountEl) reviewsCountEl.textContent = 'Sin opiniones todavía';
        return;
      }
      const avg = reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length;
      if (reviewsStarsEl) reviewsStarsEl.innerHTML = starsHTML(avg, 16);
      if (reviewsCountEl) {
        reviewsCountEl.textContent = `${avg.toFixed(1)} · ${reviews.length} ${reviews.length === 1 ? 'opinión' : 'opiniones'}`;
      }
    }

    function renderReviewList(reviews: Review[]) {
      if (reviewsEmptyEl) reviewsEmptyEl.hidden = reviews.length !== 0;
      if (reviewsItemsEl) reviewsItemsEl.innerHTML = reviews.map((r) => reviewRowHTML(r)).join('');
    }

    async function loadReviews(productId: string) {
      const { data } = await getReviewsByProduct(productId);
      const reviews = data ?? [];
      renderReviewSummary(reviews);
      renderReviewList(reviews);
    }

    if (!slug) {
      show(notFound);
    } else {
      getProductBySlug(slug).then(async ({ data: product, error }) => {
        if (error || !product) {
          show(notFound);
          return;
        }

        document.title = `${product.brand ? product.brand + ' ' : ''}${product.name} · Diapasón`;

        const { data: category } = await getCategoryBySlug(product.category_slug);
        const categoryLink = root.querySelector<HTMLAnchorElement>('[data-pdp-category-link]');
        if (categoryLink && category) {
          categoryLink.href = `/catalogo?categoria=${encodeURIComponent(category.slug)}`;
          categoryLink.textContent = category.name;
        }
        const nameEl = root.querySelector('[data-pdp-name]');
        if (nameEl) nameEl.textContent = product.name;

        const gallery = root.querySelector<HTMLElement>('[data-pdp-gallery]');
        if (gallery) {
          const images = product.images.length ? product.images : [FELT_PLACEHOLDER];
          gallery.innerHTML = images
            .map(
              (src, i) => `
              <img
                src="${escapeHtml(src)}"
                alt="${escapeHtml(i === 0 ? product.name : `${product.name} — detalle ${i + 1}`)}"
                width="1100" height="1375"
                loading="${i === 0 ? 'eager' : 'lazy'}"
                class="w-full bg-felt object-cover ${i > 0 ? 'hidden md:block' : ''}"
                ${i === 0 ? `style="view-transition-name: ${productImageTransitionName(product.slug)}"` : ''}
                onerror="this.onerror=null;this.src='${FELT_PLACEHOLDER}'"
              />`,
            )
            .join('');
        }

        const brandEl = root.querySelector('[data-pdp-brand]');
        if (brandEl) brandEl.textContent = product.brand ?? '';
        const titleEl = root.querySelector('[data-pdp-title]');
        if (titleEl) titleEl.textContent = product.name;
        const priceEl = root.querySelector('[data-pdp-price]');
        if (priceEl) priceEl.textContent = formatPriceJS(product.price);
        const descEl = root.querySelector('[data-pdp-description]');
        if (descEl) descEl.textContent = product.description ?? '';

        const stockEl = root.querySelector('[data-pdp-stock]');
        if (stockEl) {
          const available = product.stock > 0;
          stockEl.innerHTML = `
            <p class="flex items-center gap-2.5 text-[0.82rem] font-medium tracking-[0.01em]">
              <span class="inline-block h-2 w-2 rounded-full ${available ? 'bg-brass' : 'bg-line-strong'}"></span>
              ${available ? 'Disponible para envío hoy' : 'Sin stock por ahora · consulta por WhatsApp'}
            </p>`;
        }

        const addBtn = root.querySelector<HTMLElement>('[data-pdp-add-to-cart]');
        if (addBtn) {
          addBtn.setAttribute(
            'data-add-to-cart',
            JSON.stringify({
              id: product.id,
              slug: product.slug,
              name: product.name,
              price: product.price,
              image: product.images[0] || FELT_PLACEHOLDER,
            }),
          );
        }

        const waBtn = root.querySelector<HTMLAnchorElement>('[data-pdp-whatsapp]');
        if (waBtn) waBtn.href = whatsappLink({ name: product.name, brand: product.brand });

        const specs = (product.specs ?? []) as Spec[];
        const specsWrap = root.querySelector<HTMLElement>('[data-pdp-specs-wrap]');
        const specsEl = root.querySelector<HTMLElement>('[data-pdp-specs]');
        if (specs.length && specsWrap && specsEl) {
          specsWrap.classList.remove('hidden');
          specsEl.innerHTML = specs
            .map(
              (s) => `
              <div class="grid grid-cols-[minmax(0,10rem)_1fr] gap-4 border-b border-line py-3">
                <dt class="text-[0.82rem] font-medium tracking-[0.01em] text-brass-ink">${escapeHtml(s.label)}</dt>
                <dd class="text-[0.9rem] leading-relaxed">${escapeHtml(s.value)}</dd>
              </div>`,
            )
            .join('');
        }

        show(content);

        await loadReviews(product.id);

        reviewForm?.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (reviewError) reviewError.hidden = true;
          if (reviewSuccess) reviewSuccess.hidden = true;

          const rating = Number(reviewRatingInput?.value || 0);
          if (!rating) {
            if (reviewError) {
              reviewError.textContent = 'Selecciona una calificación de 1 a 5 estrellas.';
              reviewError.hidden = false;
            }
            return;
          }

          const submitBtn = reviewForm.querySelector<HTMLButtonElement>('button[type="submit"]');
          if (submitBtn) submitBtn.disabled = true;

          const { session, profile } = getAuthState();
          const { error: reviewSubmitError } = await addReview({
            productId: product.id,
            userId: session?.user.id ?? null,
            authorName: reviewAuthorInput?.value || '',
            avatarUrl: profile?.avatar_url,
            rating,
            comment: reviewCommentInput?.value || '',
          });

          if (submitBtn) submitBtn.disabled = false;

          if (reviewSubmitError) {
            if (reviewError) {
              reviewError.textContent = 'No se pudo publicar tu opinión. Intenta de nuevo en unos minutos.';
              reviewError.hidden = false;
            }
            return;
          }

          if (reviewSuccess) reviewSuccess.hidden = false;
          reviewForm.reset();
          setRating(0);
          applyAuthorFromSession();
          await loadReviews(product.id);
          // Lets the home page's live ticker refetch and pick up this review immediately.
          window.dispatchEvent(new CustomEvent('review-submitted'));
        });

        const relatedSection = document.querySelector<HTMLElement>('[data-pdp-related]');
        const relatedSlot = document.querySelector<HTMLElement>('[data-pdp-related-slot]');
        const related = await getRelatedProducts(product, 6);
        if (related.length && relatedSection && relatedSlot) {
          relatedSlot.innerHTML = productRailHTML(related);
          relatedSection.classList.remove('hidden');
        }
      });
    }
  }

  document.addEventListener('astro:page-load', init);
</script>
