---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import SpecsTable from '@/components/SpecsTable.astro';
import StockBadge from '@/components/StockBadge.astro';
import ProductRail from '@/components/ProductRail.astro';
import { SITE, formatPrice, whatsappLink } from '@/config';
import { getProducts, getProductBySlug, getRelated, getCategory } from '@/lib/catalog';
import { unsplash, FELT_PLACEHOLDER } from '@/lib/img';

export function getStaticPaths() {
  return getProducts().map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const category = getCategory(product.categorySlug);
const related = getRelated(product, 6);
const gallery = product.images.map((id, i) => unsplash(id, i === 0 ? 1100 : 800, '4/5'));
const ogImage = unsplash(product.images[0], 1200, '16/9');
---

<Base
  title={`${product.brand} ${product.name}`}
  description={product.story}
  ogImage={ogImage}
>
  <div class="shell pt-10 md:pt-14">
    <nav aria-label="Migas" class="text-[0.78rem] tracking-[0.02em] text-brass-ink">
      <a href="/catalogo" class="hover:underline">Catálogo</a>
      <span aria-hidden="true"> / </span>
      <a href={`/catalogo/${product.categorySlug}`} class="hover:underline">{category?.name}</a>
      <span aria-hidden="true"> / </span>
      {product.name}
    </nav>

    <div class="mt-8 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <!-- Media -->
      <div class="flex flex-col gap-4">
        {gallery.map((src, i) => (
          <img
            src={src}
            alt={i === 0 ? `${product.brand} ${product.name}` : `${product.name} — detalle ${i + 1}`}
            width="1100"
            height="1375"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            class:list={['w-full bg-felt object-cover', i > 0 && 'hidden md:block']}
            onerror={`this.onerror=null;this.src='${FELT_PLACEHOLDER}'`}
          />
        ))}
      </div>

      <!-- Detail -->
      <div class="lg:sticky lg:top-24 lg:h-fit">
        <p class="text-[0.78rem] font-medium uppercase tracking-[0.16em] text-brass-ink">
          {product.brand}
        </p>
        <h1 class="mt-2 text-[1.7rem] font-semibold leading-tight md:text-[2rem]">{product.name}</h1>
        <p class="u-tabular mt-3 text-[1.15rem] font-medium">{formatPrice(product.price)}</p>

        <p class="prose-editorial mt-6 !text-[1.02rem]">{product.story}</p>

        <div class="mt-8">
          <StockBadge state={product.stock} />
        </div>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button
            variant="solid"
            data-add-to-cart={product.slug}
            class="justify-center sm:justify-start"
          >
            <span data-add-label>Añadir al carrito</span>
          </Button>
          <Button
            href={whatsappLink(product)}
            variant="outline"
            icon="whatsapp"
            class="justify-center sm:justify-start"
          >
            Consultar disponibilidad
          </Button>
        </div>
        {!SITE.whatsappNumber && (
          <p class="mt-3 text-[0.78rem] text-brass-ink">
            Configura el número de WhatsApp en <code>src/config.ts</code> para activar este botón.
          </p>
        )}

        <div class="mt-12">
          <h2 class="h-section !text-[1.05rem]">Especificaciones</h2>
          <div class="mt-4">
            <SpecsTable specs={product.specs} />
          </div>
        </div>

        <p class="mt-8 text-[0.82rem] leading-relaxed text-brass-ink">
          Incluye ajuste inicial en taller y garantía de 12 meses. Envío a todo el país;
          entrega estimada de 2 a 5 días hábiles en compras con stock.
        </p>
      </div>
    </div>
  </div>

  {related.length > 0 && (
    <section class="mt-24 md:mt-32">
      <div class="shell">
        <h2 id="rel-h" class="h-section">También en {category?.name.toLowerCase()}</h2>
      </div>
      <div class="shell mt-10">
        <ProductRail products={related} labelledby="rel-h" />
      </div>
    </section>
  )}
</Base>
