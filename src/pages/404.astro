---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
---

<Base title="Página no encontrada">
  <div class="shell flex min-h-[60svh] flex-col justify-center py-20">
    <p class="h-display max-w-[14ch]">Esta página no está afinada.</p>
    <p class="prose-editorial mt-5">
      El enlace que seguiste no lleva a ningún lado. Vuelve al catálogo y sigue desde ahí.
    </p>
    <div class="mt-8">
      <Button href="/catalogo" variant="solid" icon="arrow-right">Ir al catálogo</Button>
    </div>
    <ul class="mt-10 flex flex-wrap gap-2" data-notfound-categories></ul>
  </div>
</Base>

<script>
  import { listCategories } from '@/lib/supabase/categories';
  import { escapeHtml } from '@/scripts/product-render';

  function init() {
    const list = document.querySelector<HTMLElement>('[data-notfound-categories]');
    if (!list) return;
    listCategories().then(({ data }) => {
      if (!data || !data.length) return;
      list.innerHTML = data
        .map(
          (c) =>
            `<li><a href="/catalogo?categoria=${encodeURIComponent(c.slug)}" class="chip">${escapeHtml(c.name)}</a></li>`,
        )
        .join('');
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
