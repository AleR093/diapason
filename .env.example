# Copy this file to .env and fill in your own Supabase project values.
# Settings → API in your Supabase dashboard. The anon key is safe to expose
# client-side — access control happens through Row Level Security, not by
# hiding this key. Never put the "service_role" key here or in any PUBLIC_*
# variable.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
